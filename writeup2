```bash
for f in *.pcap; do
  n=$(grep -aoP '//file\K\d+' "$f")
  [ -n "$n" ] && printf '%s\t%s\n' "$n" "$f"
done | sort -n | cut -f2 | while read f; do
  cat "$f"; echo    # the echo ensures the trailing \n missing at the end of each file
done > raw.c

perl -0777 -pe 's{/\*.*?\*/}{}gs; s{//[^\n]*}{}g' raw.c > result.c

gcc -w result.c -o result && ./result
```

